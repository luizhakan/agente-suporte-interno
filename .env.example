# Configuração de Ambiente do Agente de Suporte Interno

# Obrigatória para /api/v1/query e /metrics. Gere um valor longo e aleatório.
INTERNAL_API_KEY=

# Origens web autorizadas, separadas por vírgula. Não use * em produção.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Provedor de LLM: ollama (local padrão), openai (cloud) ou mock (testes)
LLM_PROVIDER=ollama

# Ativa os serviços locais do Ollama no Docker Compose. Para cloud, deixe vazio.
COMPOSE_PROFILES=local

# Modelo local leve e multilíngue usado como verificador de evidência (1,4 GB)
OLLAMA_BASE_URL=http://ollama:11434/api
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_CONTEXT_CHUNKS=4

# Chave de API (necessária apenas se LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings semânticos multilíngues locais (239 MB). Use dense apenas em testes/CI.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
EMBEDDING_TIMEOUT_SECONDS=60.0
AUTO_INGEST_ON_STARTUP=true

# Parâmetros de Suficiência RAG (Calibrados)
RAG_TAU=0.28
RAG_STRONG_TAU=0.40
RAG_CATALOG_TAU=0.20
RAG_CATALOG_COMPETITION_MARGIN=0.035
RAG_DELTA=0.10
RAG_TOP_K=4
RAG_SEMANTIC_WEIGHT=0.80
RAG_LEXICAL_WEIGHT=0.20
RAG_CONSTRAINT_MARGIN=0.03
RAG_CONSTRAINT_PENALTY_WEIGHT=1.5

# Resiliência e Timeouts
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=1
LLM_CONCURRENCY_LIMIT=20
